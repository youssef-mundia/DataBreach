# Environment Configuration
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=databreach
POSTGRES_PASSWORD=databreach123
POSTGRES_DB=databreach
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Tor Configuration
TOR_PROXY_HOST=127.0.0.1
TOR_PROXY_PORT=9050
TOR_CONTROL_PORT=9051
# TOR_PASSWORD=your-tor-control-password

# Telegram Configuration (Required for Telegram monitoring)
# TELEGRAM_API_ID=your-telegram-api-id
# TELEGRAM_API_HASH=your-telegram-api-hash
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_SESSION_STRING=your-session-string

# AI Configuration
# HUGGINGFACE_TOKEN=your-huggingface-token
# LLAMA_MODEL_PATH=/path/to/llama/model

# CAPTCHA Services (Optional)
# TWOCAPTCHA_API_KEY=your-2captcha-api-key
# ANTICAPTCHA_API_KEY=your-anticaptcha-api-key

# Email Alerts (Optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-email-password

# Slack Alerts (Optional)
# SLACK_WEBHOOK_URL=your-slack-webhook-url

# Monitoring
PROMETHEUS_PORT=8000
LOG_LEVEL=INFO